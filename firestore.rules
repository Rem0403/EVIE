rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function circlePath(id) { return /databases/$(database)/documents/circles/$(id); }
    function isMember(circleId) {
      return signedIn() && request.auth.uid in get(circlePath(circleId)).data.memberIds;
    }
    // Membership once the whole write (or batch) is applied: creating and joining are batches.
    function isMemberAfter(circleId) {
      return signedIn() && request.auth.uid in getAfter(circlePath(circleId)).data.memberIds;
    }

    // A code is its own doc, so it can be looked up by exact value but circles can't be listed.
    // Written in the same batch as its circle; never edited, so a taken code can't be claimed.
    match /joinCodes/{code} {
      allow get: if signedIn();
      allow create: if request.resource.data.keys().hasOnly(['circleId'])
        && isMemberAfter(request.resource.data.circleId)
        && getAfter(circlePath(request.resource.data.circleId)).data.joinCode == code;
    }

    match /circles/{circleId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn() && request.resource.data.memberIds == [request.auth.uid];
      allow update: if signedIn() && (
        // Members may edit the care plan, rename or replace the code, but not change who is in the circle.
        (
          request.auth.uid in resource.data.memberIds
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'personName', 'joinCode', 'meds', 'profile'])
        )
        || (
          // Joining: add only yourself, proving you know the current code through the
          // member doc written in the same batch.
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
          && request.resource.data.memberIds.removeAll(resource.data.memberIds) == [request.auth.uid]
          && resource.data.memberIds.removeAll(request.resource.data.memberIds).size() == 0
          && getAfter(/databases/$(database)/documents/circles/$(circleId)/members/$(request.auth.uid)).data.joinCode
            == resource.data.joinCode
        )
      );

      match /members/{uid} {
        allow read: if isMember(circleId);
        allow create, update: if uid == request.auth.uid && isMemberAfter(circleId);
      }

      match /entries/{entryId} {
        allow read: if isMember(circleId);
        // Entries are signed by whoever logs them, and the author can't be changed later.
        allow create: if isMember(circleId) && request.resource.data.createdBy == request.auth.uid;
        allow update: if isMember(circleId) && request.resource.data.createdBy == resource.data.createdBy;
        allow delete: if isMember(circleId) && resource.data.createdBy == request.auth.uid;
      }
    }
  }
}
